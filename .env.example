# Copy this file to .env and fill real values locally.
# Do not commit .env.

MYSQL_URL=jdbc:mysql://localhost:3306/example_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

DEEPSEEK_API_KEY=你自己申请的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：每场模拟面试的题目数量（默认 5）
APP_INTERVIEW_TOTAL_QUESTIONS=5

# 可选：接口鉴权 Token。留空表示关闭；设置后所有请求需带 X-API-Token 头。
# 同时建议把 SERVER_ADDRESS 设为 0.0.0.0 以外网暴露时启用鉴权。
APP_AUTH_TOKEN=

# 可选：服务监听地址（默认 127.0.0.1 仅本机；设为 0.0.0.0 对外暴露）
SERVER_ADDRESS=127.0.0.1
